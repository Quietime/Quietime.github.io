{
  "name": "quietime-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Quietime 静夜工作室 photography website",
  "scripts": {
    "admin": "node scripts/admin.mjs",
    "images": "node scripts/images.mjs",
    "pages": "node scripts/generate.mjs",
