    "@theatre/core": "^0.7.2",
    "exif-reader": "^2.0.3",
    "gsap": "3.15",
    "justified-layout": "^4.1.0",
    "lenis": "1.3",
    "lottie-web": "^5.13.0",
    "morphicons": "^2.0.2",
    "photoswipe": "^5.4.4",
